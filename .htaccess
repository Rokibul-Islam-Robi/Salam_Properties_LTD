Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_URI} ^(.*)\/[^\/]*$
RewriteRule ^(about|services|project|news|contact)\.html$ %{REQUEST_SCHEME}://%{HTTP_HOST}%1/$1.php [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*)\/[^\/]*$
RewriteRule ^index\.html$ %{REQUEST_SCHEME}://%{HTTP_HOST}%1/index.php [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*)\/[^\/]*$
RewriteRule ^service\.html$ %{REQUEST_SCHEME}://%{HTTP_HOST}%1/services.php [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*)\/[^\/]*$
RewriteRule ^blog\.html$ %{REQUEST_SCHEME}://%{HTTP_HOST}%1/news.php [R=301,L]
</IfModule>
<FilesMatch "\.(json|log)$">
Require all denied
</FilesMatch>
