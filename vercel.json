{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/favicon.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin.php"
    },
    {
      "src": "/admin",
      "dest": "/api/admin.php"
    },
    {
      "src": "/api_inquiry.php",
      "dest": "/api/api_inquiry.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
